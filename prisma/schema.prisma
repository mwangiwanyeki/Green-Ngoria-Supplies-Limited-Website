// =============================================================================
// GREEN NGORIA SUPPLIES LIMITED — PRISMA SCHEMA
// Enterprise Mining & Mining-Plant Operations Platform
// =============================================================================
// Database: PostgreSQL (Supabase)
// ORM:      Prisma 5
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

