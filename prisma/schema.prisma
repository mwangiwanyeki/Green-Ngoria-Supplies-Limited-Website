// =============================================================================

model MediaAsset {
  id             String    @id @default(uuid())
  organizationId String
  filename       String
  storageKey     String
  mimeType       String
  sizeBytes      Int
  width          Int?
  height         Int?
  altText        String?
  uploadedById   String
