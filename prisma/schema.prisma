// =============================================================================
// SYSTEM 0 — IDENTITY & ACCESS
// =============================================================================

model User {
  id                     String     @id @default(uuid())
  email                  String     @unique
  passwordHash           String
  firstName              String
  lastName               String
  phone                  String?
  avatarUrl              String?
  status                 UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt        DateTime?
  emailVerificationToken String?    @unique
  passwordResetToken     String?    @unique
  passwordResetExpiry    DateTime?
  mfaEnabled             Boolean    @default(false)
  mfaSecret              String? // Encrypted TOTP secret
  failedLoginAttempts    Int        @default(0)
  lockedUntil            DateTime?
  lastLoginAt            DateTime?
  lastLoginIp            String?
  mustChangePassword     Boolean    @default(false)
  timezone               String?    @default("Africa/Nairobi")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  deletedAt              DateTime?

  // Relations
  organizationMemberships OrganizationMember[]
  userRoles               UserRole[]
  sessions                UserSession[]
  auditLogs               AuditLog[]
  notifications           Notification[]
  assignedLeads           Lead[]                @relation("AssignedLeads")
  createdLeads            Lead[]                @relation("CreatedLeads")
  assignedProjects        Project[]             @relation("ProjectManager")
  projectTasks            ProjectTask[]         @relation("AssignedTasks")
  documents               EngineeringDocument[]
  supportTickets          SupportTicket[]       @relation("ClientTickets")
  assignedTickets         SupportTicket[]       @relation("AssignedTickets")
  assignedAssessments     PlantAssessment[]     @relation("AssignedAssessments")

  // Operations ERP
  staffProfile          Staff?
  posSales              Sale[]               @relation("SaleCashier")
  stockMovements        StockMovement[]      @relation("StockMovementPerformedBy")
  recordedExpenses      Expense[]            @relation("ExpenseRecordedBy")
  accountTransactions   AccountTransaction[] @relation("AccountTransactionRecordedBy")
  receivedDebtPayments  DebtPayment[]        @relation("DebtPaymentReceivedBy")
  recordedVatRentals    VatLeachRental[]     @relation("VatLeachRentalRecordedBy")
  stockPileMovements    StockPileMovement[]  @relation("StockPileMovementRecordedBy")
  reportedSecurityLogs  SecurityLog[]        @relation("SecurityLogReportedBy")
  processedPayrollRuns  PayrollRun[]         @relation("PayrollProcessedBy")
  approvedPayrollRuns   PayrollRun[]         @relation("PayrollApprovedBy")
  reviewedLeaveRequests LeaveRequest[]       @relation("LeaveReviewedBy")
  registeredVisitors    Visitor[]            @relation("VisitorRegisteredBy")
  uploadedMediaAssets   MediaAsset[]         @relation("MediaAssetUploadedBy")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model Role {
  /// `name` holds a `SystemRole` value for built-in roles (isSystem = true) and a
  /// free-form UPPER_SNAKE_CASE identifier for organization-defined custom roles.
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "quotation:approve"
  resource    String // e.g. "quotation"
  action      String // e.g. "approve"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  grantedBy String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// ORGANIZATIONS & TENANCY
// =============================================================================

model Organization {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  type        OrganizationType @default(CLIENT)
  email       String?
  phone       String?
  website     String?
  logoUrl     String?
  country     String?          @default("Kenya")
  city        String?
  address     String?
  taxPin      String?
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  members         OrganizationMember[]
  clients         Client[]
  clientOrgFor    Client[]              @relation("ClientOrganization")
  projects        Project[]
  leads           Lead[]
  rfqs            Rfq[]
  quotations      Quotation[]
  contracts       Contract[]
  invoices        Invoice[]
  documents       EngineeringDocument[]
  assets          Asset[]
  supportTickets  SupportTicket[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  vendors         Vendor[]
  mineralProjects MineralProject[]

  // Operations ERP
  branches             Branch[]
  inventoryCategories  InventoryCategory[]
  inventoryItems       InventoryItem[]
  stores               Store[]
  sales                Sale[]
  erpCustomers         Customer[]
  customerDebtAccounts CustomerDebtAccount[]
  expenseCategories    ExpenseCategory[]
  expenses             Expense[]
  financialAccounts    FinancialAccount[]
  vatLeachUnits        VatLeachUnit[]
  vatLeachRentals      VatLeachRental[]
  stockPiles           StockPile[]
  securityLogs         SecurityLog[]
  staff                Staff[]
  payrollRuns          PayrollRun[]
  leaveRequests        LeaveRequest[]
  attendanceRecords    AttendanceRecord[]
  visitors             Visitor[]
  StockMovement        StockMovement[]
  DebtPayment          DebtPayment[]
  AccountTransaction   AccountTransaction[]
  mediaAssets          MediaAsset[]

  @@index([type])
  @@map("organizations")
}

model OrganizationMember {
  id             String     @id @default(uuid())
  organizationId String
  userId         String
  role           SystemRole @default(CLIENT_USER)
  isOwner        Boolean    @default(false)
  joinedAt       DateTime   @default(now())
  removedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, removedAt])
  @@map("organization_members")
}

// =============================================================================
// SYSTEM 1 — CLIENTS & CRM
// =============================================================================

model Client {
  id             String    @id @default(uuid())
  organizationId String
  clientOrgId    String? // The client's own Organization record
  clientNumber   String    @unique
  companyName    String
  industry       String?
  country        String?
  city           String?
  address        String?
  website        String?
  email          String?
  phone          String?
  miningInterest String?
  notes          String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization    Organization      @relation(fields: [organizationId], references: [id])
  clientOrg       Organization?     @relation("ClientOrganization", fields: [clientOrgId], references: [id])
  contacts        ClientContact[]
  leads           Lead[]
  projects        Project[]
  quotations      Quotation[]
  contracts       Contract[]
  invoices        Invoice[]
  assessments     PlantAssessment[]
  rfqs            Rfq[]
  mineralProjects MineralProject[]
  erpCustomers    Customer[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([organizationId, deletedAt, createdAt])
  @@index([clientOrgId])
  @@map("clients")
}

model ClientContact {
  id        String    @id @default(uuid())
  clientId  String
  firstName String
  lastName  String
  email     String?
  phone     String?
  position  String?
  isPrimary Boolean   @default(false)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Lead {
  id                 String       @id @default(uuid())
  organizationId     String
  clientId           String?
  reference          String       @unique
  companyName        String
  contactName        String
  contactEmail       String?
  contactPhone       String?
  country            String?
  source             LeadSource   @default(WEBSITE)
  status             LeadStatus   @default(NEW)
  estimatedValue     Decimal?     @db.Decimal(15, 2)
  currency           Currency     @default(USD)
  mineralType        MineralType?
  miningLocation     String?
  projectDescription String?
  priority           String?      @default("MEDIUM")
  score              Int          @default(0)
  ownerId            String?
  createdById        String
  nextFollowUpAt     DateTime?
  wonAt              DateTime?
  lostAt             DateTime?
  lostReason         String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  organization  Organization      @relation(fields: [organizationId], references: [id])
  client        Client?           @relation(fields: [clientId], references: [id])
  owner         User?             @relation("AssignedLeads", fields: [ownerId], references: [id])
  createdBy     User              @relation("CreatedLeads", fields: [createdById], references: [id])
  activities    CrmActivity[]
  consultations Consultation[]
  assessments   PlantAssessment[]

  @@index([organizationId])
  @@index([status])
  @@index([ownerId])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@map("leads")
}

model CrmActivity {
  id          String    @id @default(uuid())
  leadId      String
  type        String // CALL | EMAIL | MEETING | NOTE | FOLLOW_UP | TASK
  subject     String
  description String?
  dueAt       DateTime?
  completedAt DateTime?
  outcome     String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("crm_activities")
}

model Consultation {
  id          String    @id @default(uuid())
  leadId      String
  scheduledAt DateTime
  completedAt DateTime?
  type        String // INITIAL | TECHNICAL | FOLLOW_UP | SITE_VISIT
  location    String?
  notes       String?
  outcome     String?
  nextSteps   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("consultations")
}

// =============================================================================
// SYSTEM 1b — MINING SITES & MINERAL PROJECTS
// =============================================================================

model MiningSite {
  id           String   @id @default(uuid())
  name         String
  country      String   @default("Kenya")
  county       String?
  coordinates  String? // "lat,lng"
  mineralTypes String[] // array of MineralType values
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects        Project[]
  assessments     PlantAssessment[]
  mineralProjects MineralProject[]
  stockPiles      StockPile[]
  VatLeachUnit    VatLeachUnit[]
  SecurityLog     SecurityLog[]

  @@map("mining_sites")
}

model MineralProject {
  id               String      @id @default(uuid())
  organizationId   String
  clientId         String?
  miningSiteId     String?
  name             String
  mineralType      MineralType
  description      String?
  estimatedTph     Decimal?    @db.Decimal(10, 2) // tonnes per hour
  estimatedAuGrade Decimal?    @db.Decimal(8, 3) // g/t
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  miningSite   MiningSite?  @relation(fields: [miningSiteId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
  @@index([miningSiteId])
  @@map("mineral_projects")
}

// =============================================================================
// SYSTEM 4 — TECHNICAL PLANT ASSESSMENT
// =============================================================================

model PlantAssessment {
  id             String           @id @default(uuid())
  organizationId String
  reference      String           @unique
  clientId       String?
  leadId         String?
  miningSiteId   String?
  status         AssessmentStatus @default(DRAFT)

  // Client/project context
  clientName     String
  projectName    String?
  miningLocation String?
  mineralType    MineralType?
  estimatedTph   Decimal?     @db.Decimal(10, 2)

  // Ore characteristics
  oreDescription String?
  oreGrade       Decimal? @db.Decimal(8, 3)
  oreMineralogy  String?
  oreHardness    String?

  // Existing plant
  hasExistingPlant  Boolean  @default(false)
  existingPlantDesc String?
  existingCapacity  Decimal? @db.Decimal(10, 2)

  // Process circuit data (JSON objects for flexibility)
  crushingData       Json?
  grindingData       Json?
  classificationData Json?
  leachingData       Json?
  adsorptionData     Json?
  elutionData        Json?
  tailingsData       Json?
  waterData          Json?
  powerData          Json?
  reagentsData       Json?

  // Performance
  currentRecovery     Decimal? @db.Decimal(5, 2)
  targetRecovery      Decimal? @db.Decimal(5, 2)
  operationalProblems String?

  // HSE & environment
  hseConstraints           String?
  environmentalConstraints String?

  // Client objectives
  clientObjectives String?
  additionalNotes  String?

  // Workflow
  submittedAt        DateTime?
  reviewStartedAt    DateTime?
  completedAt        DateTime?
  assignedEngineerId String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  client           Client?                    @relation(fields: [clientId], references: [id])
  lead             Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  miningSite       MiningSite?                @relation(fields: [miningSiteId], references: [id])
  assignedEngineer User?                      @relation("AssignedAssessments", fields: [assignedEngineerId], references: [id])
  findings         AssessmentFinding[]
  recommendations  AssessmentRecommendation[]
  attachments      AssessmentAttachment[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@index([assignedEngineerId])
  @@map("plant_assessments")
}

model AssessmentFinding {
  id              String          @id @default(uuid())
  assessmentId    String
  category        String // CRUSHING | GRINDING | LEACHING | ADSORPTION | ELUTION | TAILINGS | UTILITIES | SAFETY | OTHER
  severity        FindingSeverity @default(MODERATE)
  title           String
  observation     String
  evidence        String?
  affectedProcess String?
  technicalImpact String?
  createdAt       DateTime        @default(now())

  assessment      PlantAssessment            @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  recommendations AssessmentRecommendation[]

  @@index([assessmentId])
  @@map("assessment_findings")
}

model AssessmentRecommendation {
  id                        String    @id @default(uuid())
  assessmentId              String
  findingId                 String?
  recommendation            String
  priority                  String    @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  expectedBenefit           String?
  requiredWork              String?
  estimatedCost             Decimal?  @db.Decimal(15, 2)
  currency                  Currency  @default(USD)
  engineeringReviewRequired Boolean   @default(true)
  // IMPORTANT: recommendations require engineering review before being presented as certified advice
  engineeringApprovedAt     DateTime?
  engineeringApprovedBy     String?
  status                    String    @default("PENDING") // PENDING | APPROVED | IMPLEMENTED | DEFERRED
  createdAt                 DateTime  @default(now())

  assessment PlantAssessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  finding    AssessmentFinding? @relation(fields: [findingId], references: [id])

  @@index([assessmentId])
  @@index([findingId])
  @@map("assessment_recommendations")
}

model AssessmentAttachment {
  id           String   @id @default(uuid())
  assessmentId String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  checksum     String?
  description  String?
  uploadedById String
  createdAt    DateTime @default(now())

  assessment PlantAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@map("assessment_attachments")
}

// =============================================================================
// SYSTEM 2 — EQUIPMENT & SPARES CATALOGUE
// =============================================================================

model EquipmentCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  parent    EquipmentCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  EquipmentCategory[] @relation("CategoryTree")
  equipment Equipment[]

  @@map("equipment_categories")
}

model Equipment {
  id             String    @id @default(uuid())
  organizationId String?
  categoryId     String?
  sku            String    @unique
  name           String
  model          String?
  manufacturer   String?
  description    String?
  application    String?
  capacity       String?
  powerKw        Decimal?  @db.Decimal(10, 2)
  weight         Decimal?  @db.Decimal(10, 2)
  dimensions     String?
  specifications Json?
  isAvailable    Boolean   @default(true)
  leadTimeDays   Int?
  isPublished    Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  category EquipmentCategory? @relation(fields: [categoryId], references: [id])
  spares   SparePart[]
  rfqItems RfqItem[]
  assets   Asset[]

  @@index([isPublished])
  @@index([deletedAt])
  @@map("equipment")
}

model SparePart {
  id                  String    @id @default(uuid())
  equipmentId         String?
  sku                 String    @unique
  name                String
  partNumber          String?
  manufacturer        String?
  description         String?
  specifications      Json?
  quantityInStock     Int       @default(0)
  reorderLevel        Int       @default(0)
  unitPrice           Decimal?  @db.Decimal(15, 4)
  currency            Currency  @default(USD)
  isAvailable         Boolean   @default(true)
  leadTimeDays        Int?
  compatibleEquipment String[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([deletedAt])
  @@map("spare_parts")
}

// =============================================================================
// SYSTEM 2b — RFQ
// =============================================================================

model Rfq {
  id                    String    @id @default(uuid())
  organizationId        String
  clientId              String?
  projectId             String?
  rfqNumber             String    @unique
  title                 String
  description           String?
  deliveryLocation      String?
  requiredByDate        DateTime?
  technicalRequirements String?
  status                RfqStatus @default(DRAFT)
  submittedAt           DateTime?
  respondedAt           DateTime?
  closedAt              DateTime?
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  client       Client?         @relation(fields: [clientId], references: [id])
  project      Project?        @relation(fields: [projectId], references: [id])
  items        RfqItem[]
  attachments  RfqAttachment[]
  quotations   Quotation[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@map("rfqs")
}

model RfqItem {
  id             String  @id @default(uuid())
  rfqId          String
  equipmentId    String?
  lineNumber     Int
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String  @default("EA")
  technicalSpecs String?
  notes          String?

  rfq       Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  equipment Equipment? @relation(fields: [equipmentId], references: [id])

  @@index([rfqId])
  @@index([equipmentId])
  @@map("rfq_items")
}

model RfqAttachment {
  id           String   @id @default(uuid())
  rfqId        String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  storageKey   String
  checksum     String?
  createdAt    DateTime @default(now())

  rfq Rfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_attachments")
}

// =============================================================================
// SYSTEM 2c — QUOTATION
// =============================================================================

model Quotation {
  id              String          @id @default(uuid())
  organizationId  String
  clientId        String?
  projectId       String?
  rfqId           String?
  quoteNumber     String          @unique
  revision        Int             @default(0)
  title           String
  description     String?
  status          QuotationStatus @default(DRAFT)
  currency        Currency        @default(USD)
  subtotal        Decimal         @default(0) @db.Decimal(15, 2)
  taxRate         Decimal         @default(16) @db.Decimal(5, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(15, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(15, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(15, 2)
  deliveryTerms   String?
  paymentTerms    String?
  warrantyTerms   String?
  technicalNotes  String?
  commercialNotes String?
  validUntil      DateTime?
  pdfStorageKey   String?
  approvedById    String?
  approvedAt      DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  convertedAt     DateTime?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  client       Client?             @relation(fields: [clientId], references: [id])
  project      Project?            @relation(fields: [projectId], references: [id])
  rfq          Rfq?                @relation(fields: [rfqId], references: [id])
  lineItems    QuotationItem[]
  revisions    QuotationRevision[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@index([approvedById])
  @@index([createdById])
  @@map("quotations")
}

model QuotationItem {
  id             String  @id @default(uuid())
  quotationId    String
  lineNumber     Int
  description    String
  quantity       Decimal @db.Decimal(10, 2)
  unit           String  @default("EA")
  unitPrice      Decimal @db.Decimal(15, 4)
  discountPct    Decimal @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(15, 2)
  specifications String?
  leadTimeDays   Int?
  notes          String?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationRevision {
  id          String   @id @default(uuid())
  quotationId String
  revision    Int
  reason      String
  snapshot    Json // Full quotation state at time of revision
  createdById String
  createdAt   DateTime @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_revisions")
}

// =============================================================================
// SYSTEM 1 — PROJECTS
// =============================================================================

model Project {
  id             String        @id @default(uuid())
  organizationId String
  clientId       String?
  miningSiteId   String?
  projectNumber  String        @unique
  name           String
  description    String?
  type           ProjectType   @default(MINERAL_PROCESSING)
  status         ProjectStatus @default(AWARDED)
  currency       Currency      @default(USD)
  contractValue  Decimal?      @db.Decimal(15, 2)
  budgetAmount   Decimal?      @db.Decimal(15, 2)
  startDate      DateTime?
  targetEndDate  DateTime?
  actualEndDate  DateTime?
  managerId      String?
  location       String?
  country        String?       @default("Kenya")
  mineralType    MineralType?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization  Organization             @relation(fields: [organizationId], references: [id])
  client        Client?                  @relation(fields: [clientId], references: [id])
  miningSite    MiningSite?              @relation(fields: [miningSiteId], references: [id])
  manager       User?                    @relation("ProjectManager", fields: [managerId], references: [id])
  milestones    ProjectMilestone[]
  tasks         ProjectTask[]
  risks         ProjectRisk[]
  rfqs          Rfq[]
  quotations    Quotation[]
  contract      Contract?                @relation("ProjectContract")
  procurement   ProcurementRequisition[]
  siteReports   SiteReport[]
  hseIncidents  HseIncident[]
  commissioning CommissioningSystem[]
  assets        Asset[]
  documents     EngineeringDocument[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@map("projects")
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String
  name        String
  description String?
  dueDate     DateTime?
  completedAt DateTime?
  status      MilestoneStatus @default(PENDING)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   ProjectTask[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectTask {
  id          String    @id @default(uuid())
  projectId   String
  milestoneId String?
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  completedAt DateTime?
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE | BLOCKED
  priority    String    @default("MEDIUM")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignee  User?             @relation("AssignedTasks", fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([milestoneId])
  @@index([assigneeId])
  @@map("project_tasks")
}

model ProjectRisk {
  id          String    @id @default(uuid())
  projectId   String
  title       String
  description String?
  category    String?
  likelihood  RiskLevel @default(MEDIUM)
  impact      RiskLevel @default(MEDIUM)
  mitigation  String?
  owner       String?
  status      String    @default("OPEN") // OPEN | MITIGATED | CLOSED
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_risks")
}

// =============================================================================
// SYSTEM 5 — ENGINEERING DOCUMENT CONTROL
// =============================================================================

model EngineeringDocument {
  id             String         @id @default(uuid())
  organizationId String
  projectId      String?
  documentNumber String         @unique
  title          String
  type           DocumentType   @default(OTHER)
  status         DocumentStatus @default(DRAFT)
  revision       String         @default("REV_00")
  description    String?
  tags           String[]

  // File
  storageKey   String
  originalName String
  mimeType     String
  fileSize     Int
  checksum     String

  // Workflow
  authorId       String
  reviewerId     String?
  approverId     String?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  supersededAt   DateTime?
  supersededById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id])
  project      Project?           @relation(fields: [projectId], references: [id])
  author       User               @relation(fields: [authorId], references: [id])
  revisions    DocumentRevision[]

  @@index([organizationId])
  @@index([projectId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, projectId, status, deletedAt])
  @@index([reviewerId])
  @@index([approverId])
  @@map("engineering_documents")
}

model DocumentRevision {
  id          String   @id @default(uuid())
  documentId  String
  revision    String
  reason      String
  storageKey  String
  checksum    String
  createdById String
  createdAt   DateTime @default(now())

  document EngineeringDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_revisions")
}

// =============================================================================
// SYSTEM 6 — PROCUREMENT & VENDORS
// =============================================================================

model Vendor {
  id              String    @id @default(uuid())
  organizationId  String
  // ERP: suppliers are additionally scoped to a branch and carry a trading
  // category ("All Categories" filter on the Suppliers screen). Nullable so
  // pre-existing engineering-side vendors remain organization-wide.
  branchId        String?
  name            String
  contactName     String?
  companyName     String?
  category        String?
  email           String?
  phone           String?
  country         String?
  address         String?
  taxPin          String?
  website         String?
  specializations String[]
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  organization   Organization       @relation(fields: [organizationId], references: [id])
  branch         Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  quotes         ProcurementQuote[]
  purchaseOrders PurchaseOrder[]

  @@index([organizationId])
  @@index([deletedAt])
  @@index([organizationId, deletedAt, createdAt])
  @@index([branchId])
  @@index([branchId, deletedAt, createdAt])
  @@map("vendors")
}

model ProcurementRequisition {
  id             String            @id @default(uuid())
  organizationId String
  projectId      String?
  requisitionNo  String            @unique
  title          String
  description    String?
  urgency        String            @default("NORMAL") // LOW | NORMAL | URGENT | EMERGENCY
  status         ProcurementStatus @default(REQUISITION)
  requestedById  String
  approvedById   String?
  approvedAt     DateTime?
  requiredByDate DateTime?
  totalEstimated Decimal?          @db.Decimal(15, 2)
  currency       Currency          @default(USD)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  project       Project?           @relation(fields: [projectId], references: [id])
  items         ProcurementItem[]
  quotes        ProcurementQuote[]
  purchaseOrder PurchaseOrder?

  @@index([organizationId])
  @@index([status])
  @@index([requestedById])
  @@index([approvedById])
  @@map("procurement_requisitions")
}

model ProcurementItem {
  id             String   @id @default(uuid())
  requisitionId  String
  description    String
  quantity       Decimal  @db.Decimal(10, 2)
  unit           String   @default("EA")
  estimatedPrice Decimal? @db.Decimal(15, 4)
  technicalSpecs String?
  notes          String?

  requisition ProcurementRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@map("procurement_items")
}

model ProcurementQuote {
  id                  String   @id @default(uuid())
  requisitionId       String
  vendorId            String
  quoteReference      String?
  totalAmount         Decimal  @db.Decimal(15, 2)
  currency            Currency @default(USD)
  leadTimeDays        Int?
  paymentTerms        String?
  technicalCompliance Boolean  @default(false)
  notes               String?
  isSelected          Boolean  @default(false)
  receivedAt          DateTime @default(now())

  requisition ProcurementRequisition @relation(fields: [requisitionId], references: [id])
  vendor      Vendor                 @relation(fields: [vendorId], references: [id])

  @@index([requisitionId])
  @@map("procurement_quotes")
}

model PurchaseOrder {
  id               String    @id @default(uuid())
  organizationId   String
  // ERP: supplier orders raised from a branch (Orders > Suppliers).
  branchId         String?
  requisitionId    String?   @unique
  vendorId         String
  poNumber         String    @unique
  totalAmount      Decimal   @db.Decimal(15, 2)
  currency         Currency  @default(USD)
  paymentTerms     String?
  deliveryAddress  String?
  expectedDelivery DateTime?
  actualDelivery   DateTime?
  status           String    @default("ISSUED") // ISSUED | ACKNOWLEDGED | SHIPPED | DELIVERED | CANCELLED
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  requisition ProcurementRequisition? @relation(fields: [requisitionId], references: [id])
  vendor      Vendor                  @relation(fields: [vendorId], references: [id])
  branch      Branch?                 @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status, createdAt])
  @@index([vendorId])
  @@index([branchId])
  @@index([branchId, status, createdAt])
  @@map("purchase_orders")
}

// =============================================================================
// SYSTEM 7 — CONTRACTS, FINANCE, INVOICING
// =============================================================================

model Contract {
  id             String         @id @default(uuid())
  organizationId String
  clientId       String?
  projectId      String?        @unique
  contractNumber String         @unique
  title          String
  description    String?
  status         ContractStatus @default(DRAFT)
  currency       Currency       @default(USD)
  value          Decimal        @db.Decimal(15, 2)
  retentionPct   Decimal        @default(10) @db.Decimal(5, 2)
  paymentTerms   String?
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime?
  approvedById   String?
  approvedAt     DateTime?
  storageKey     String? // Signed contract PDF
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  client       Client?             @relation(fields: [clientId], references: [id])
  project      Project?            @relation("ProjectContract", fields: [projectId], references: [id])
  milestones   ContractMilestone[]
  invoices     Invoice[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@index([approvedById])
  @@map("contracts")
}

model ContractMilestone {
  id          String    @id @default(uuid())
  contractId  String
  title       String
  description String?
  amount      Decimal   @db.Decimal(15, 2)
  dueDate     DateTime?
  completedAt DateTime?
  invoiced    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("contract_milestones")
}

model Invoice {
  id             String        @id @default(uuid())
  organizationId String
  clientId       String?
  contractId     String?
  projectId      String?
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(DRAFT)
  currency       Currency      @default(USD)
  subtotal       Decimal       @db.Decimal(15, 2)
  taxRate        Decimal       @default(16) @db.Decimal(5, 2)
  taxAmount      Decimal       @db.Decimal(15, 2)
  totalAmount    Decimal       @db.Decimal(15, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(15, 2)
  amountDue      Decimal       @db.Decimal(15, 2)
  dueDate        DateTime?
  issuedAt       DateTime?
  paidAt         DateTime?
  notes          String?
  pdfStorageKey  String?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  client       Client?       @relation(fields: [clientId], references: [id])
  contract     Contract?     @relation(fields: [contractId], references: [id])
  lineItems    InvoiceItem[]
  payments     Payment[]

  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@index([contractId])
  @@index([projectId])
  @@map("invoices")
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(15, 4)
  lineTotal   Decimal @db.Decimal(15, 2)
  notes       String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  amount            Decimal       @db.Decimal(15, 2)
  currency          Currency      @default(USD)
  method            PaymentMethod @default(BANK_TRANSFER)
  transactionRef    String?
  bankName          String?
  paymentDate       DateTime
  status            PaymentStatus @default(PENDING)
  confirmedAt       DateTime?
  confirmedById     String?
  reversedAt        DateTime?
  reversalReason    String?
  notes             String?
  receiptStorageKey String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// =============================================================================
// SYSTEM 8 — SITE OPERATIONS, HSE, COMMISSIONING
// =============================================================================

model SiteReport {
  id           String   @id @default(uuid())
  projectId    String
  reportDate   DateTime
  preparedById String
  weather      String?
  workAreas    String?
  laborCount   Int?
  activities   String
  progress     String?
  materials    String?
  equipment    String?
  issues       String?
  photos       String[] // Storage keys
  nextDayPlan  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@map("site_reports")
}

model HseIncident {
  id               String              @id @default(uuid())
  organizationId   String
  projectId        String?
  title            String
  description      String
  incidentDate     DateTime
  location         String?
  severity         HseIncidentSeverity @default(NEAR_MISS)
  injuredParty     String?
  rootCause        String?
  immediateAction  String?
  correctiveAction String?
  responsibleId    String?
  dueDate          DateTime?
  closedAt         DateTime?
  isReportable     Boolean             @default(false)
  photos           String[]
  createdById      String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  project Project? @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([responsibleId])
  @@index([createdById])
  @@map("hse_incidents")
}

model CommissioningSystem {
  id          String  @id @default(uuid())
  projectId   String
  name        String // e.g. "CIP Circuit", "Crushing Circuit"
  description String?
  sortOrder   Int     @default(0)

  project Project             @relation(fields: [projectId], references: [id])
  tests   CommissioningTest[]

  @@index([projectId])
  @@map("commissioning_systems")
}

model CommissioningTest {
  id                 String                  @id @default(uuid())
  systemId           String
  testNumber         String
  title              String
  description        String?
  procedure          String?
  acceptanceCriteria String?
  status             CommissioningTestStatus @default(PRE_CHECK)
  result             CommissioningTestResult @default(PENDING)
  readings           Json?
  findings           String?
  correctiveAction   String?
  testedById         String?
  testedAt           DateTime?
  approvedById       String?
  approvedAt         DateTime?
  evidence           String[] // Storage keys (photos, docs)
  retestRequired     Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  system CommissioningSystem @relation(fields: [systemId], references: [id])

  @@index([systemId])
  @@map("commissioning_tests")
}

// =============================================================================
// SYSTEM 9 — ASSETS, MAINTENANCE, WARRANTY, SUPPORT
// =============================================================================

model Asset {
  id               String      @id @default(uuid())
  organizationId   String
  projectId        String?
  equipmentId      String?
  assetNumber      String      @unique
  name             String
  serialNumber     String?
  manufacturer     String?
  model            String?
  category         String?
  location         String?
  installationDate DateTime?
  status           AssetStatus @default(OPERATIONAL)
  condition        String?     @default("GOOD") // EXCELLENT | GOOD | FAIR | POOR
  warrantyExpiry   DateTime?
  notes            String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?

  organization Organization           @relation(fields: [organizationId], references: [id])
  project      Project?               @relation(fields: [projectId], references: [id])
  equipment    Equipment?             @relation(fields: [equipmentId], references: [id])
  workOrders   MaintenanceWorkOrder[]
  warranty     Warranty?

  @@index([organizationId])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt, createdAt])
  @@index([equipmentId])
  @@map("assets")
}

model Warranty {
  id          String   @id @default(uuid())
  assetId     String   @unique
  provider    String
  startDate   DateTime
  endDate     DateTime
  coverage    String?
  terms       String?
  contractRef String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset  Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  claims WarrantyClaim[]

  @@map("warranties")
}

model WarrantyClaim {
  id          String    @id @default(uuid())
  warrantyId  String
  claimDate   DateTime
  description String
  status      String    @default("OPEN") // OPEN | SUBMITTED | ACCEPTED | REJECTED | CLOSED
  resolution  String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  warranty Warranty @relation(fields: [warrantyId], references: [id])

  @@map("warranty_claims")
}

model MaintenanceWorkOrder {
  id                String          @id @default(uuid())
  organizationId    String
  assetId           String
  workOrderNumber   String          @unique
  type              MaintenanceType @default(PREVENTIVE)
  status            WorkOrderStatus @default(OPEN)
  title             String
  description       String
  scheduledDate     DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  closedAt          DateTime?
  assignedToId      String?
  verifiedById      String?
  laborHours        Decimal?        @db.Decimal(8, 2)
  totalCost         Decimal?        @db.Decimal(15, 2)
  currency          Currency        @default(USD)
  findings          String?
  completionNotes   String?
  verificationNotes String?
  partsUsed         Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  asset Asset @relation(fields: [assetId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status, createdAt])
  @@index([assignedToId])
  @@index([verifiedById])
  @@map("maintenance_work_orders")
}

model SupportTicket {
  id             String                @id @default(uuid())
  organizationId String
  ticketNumber   String                @unique
  clientId       String?
  subject        String
  description    String
  category       String? // TECHNICAL | SPARE_PARTS | WARRANTY | GENERAL | EMERGENCY
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  clientUserId   String?
  assignedToId   String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  resolution     String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  clientUser   User?              @relation("ClientTickets", fields: [clientUserId], references: [id])
  assignedTo   User?              @relation("AssignedTickets", fields: [assignedToId], references: [id])
  messages     TicketMessage[]
  attachments  TicketAttachment[]

  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status, createdAt])
  @@index([clientId])
  @@map("support_tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  message    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_messages")
}

model TicketAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  fileName     String
  storageKey   String
  mimeType     String
  size         Int
  uploadedById String
  createdAt    DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_attachments")
}

