// =============================================================================
// NOTIFICATIONS & AUDIT
// =============================================================================

model Notification {
  id             String           @id @default(uuid())
  userId         String
  organizationId String?
  type           NotificationType
  title          String
  message        String
  entityType     String?
  entityId       String?
  actionUrl      String?
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([readAt])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// =============================================================================
// SYSTEM 9 — REFERENCE NUMBER SEQUENCES
// =============================================================================

// Backing store for atomic, collision-free generation of human-readable
// reference numbers (invoices, quotes, POs, work orders, leads, etc.).
// One row per logical sequence key (e.g. "invoice-2026"); incremented
// atomically via an upsert inside the caller's transaction.
model ReferenceSequence {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("reference_sequences")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  userId         String
  action         String
  entity         String
  entityId       String?
  oldValues      String? // JSON string — use String to avoid PII in structured logs
  newValues      String? // JSON string
  ipAddress      String?
  userAgent      String?
  metadata       String? // JSON string
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User          @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// =====================================================================
// OPERATIONS ERP
// Absorbed from the live operations dashboard. Covers the trading and
// operations side of the business (branches, inventory, POS, debt,
// expenses, accounts, gold-processing operations, HR, visitors)
// alongside the engineering-services domain above.
// =====================================================================

enum BranchStatus {
  ACTIVE
  INACTIVE
  CLOSED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN
  WRITE_OFF
  OPENING_BALANCE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  PARTIALLY_PAID
  CREDIT
  REFUNDED
  VOIDED
}

enum SaleChannel {
  POS
  BACK_OFFICE
  ONLINE
}

enum DebtAccountStatus {
  CURRENT
  OVERDUE
  SETTLED
  WRITTEN_OFF
  SUSPENDED
}

enum FinancialAccountType {
  CASH
  BANK
  MOBILE_MONEY
  PETTY_CASH
  RECEIVABLE
  PAYABLE
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountTransactionType {
  DEBIT
  CREDIT
}

enum VatLeachStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  DECOMMISSIONED
}

enum VatLeachRentalStatus {
  PENDING
  ACTIVE
  COMPLETED
  OVERDUE
  TERMINATED
}

enum StockPileStatus {
  ACCUMULATING
  READY_FOR_PROCESSING
  PROCESSING
  PROCESSED
  DEPLETED
}

enum StockPileMovementType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  ADJUSTMENT
  ASSAY_CORRECTION
}

enum SecurityLogType {
  INCIDENT
  PATROL
  ACCESS_DENIED
  THEFT
  TRESPASS
  EQUIPMENT_TAMPERING
  SHIFT_HANDOVER
  OTHER
}

enum SecuritySeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecurityLogStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  ESCALATED
  CLOSED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
  PROBATION
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  CASUAL
  INTERN
  CONSULTANT
}

enum StaffPaymentTerms {
  MONTHLY
  BIWEEKLY
  WEEKLY
  DAILY
  PER_TASK
}

enum PayrollRunStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
  CANCELLED
}

enum PayrollEntryStatus {
  PENDING
  APPROVED
  PAID
  ON_HOLD
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  MATERNITY
  PATERNITY
  COMPASSIONATE
  UNPAID
  STUDY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
  CANCELLED
  OVERDUE
}

enum AttendanceStatus {
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  LATE
  HALF_DAY
}

enum VisitorStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  DENIED
}

// ---------------------------------------------------------------------
// Branch - every ERP record is scoped to a branch of an organization.
// Also carries the per-branch business profile and settings surfaced in
// the Settings screen (business profile, general, session security).
// ---------------------------------------------------------------------
model Branch {
  id             String       @id @default(uuid())
  organizationId String
  code           String
  name           String
  systemName     String?
  status         BranchStatus @default(ACTIVE)
  isDefault      Boolean      @default(false)

  phone      String?
  email      String?
  county     String?
  address    String?
  postalCode String?
  logoUrl    String?

  currency          Currency @default(KES)
  currencySymbol    String   @default("KSh")
  taxRate           Decimal  @default(0) @db.Decimal(5, 2)
  lowStockThreshold Int      @default(10)

  autoLogoutEnabled       Boolean @default(true)
  idleTimeoutMinutes      Int     @default(120)
  warningCountdownSeconds Int     @default(60)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  stores              Store[]
  stockMovements      StockMovement[]
  sales               Sale[]
  customers           Customer[]
  debtAccounts        CustomerDebtAccount[]
  debtPayments        DebtPayment[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  financialAccounts   FinancialAccount[]
  accountTransactions AccountTransaction[]
  vendors             Vendor[]
  purchaseOrders      PurchaseOrder[]
  vatLeachUnits       VatLeachUnit[]
  vatLeachRentals     VatLeachRental[]
  stockPiles          StockPile[]
  securityLogs        SecurityLog[]
  staff               Staff[]
  payrollRuns         PayrollRun[]
  leaveRequests       LeaveRequest[]
  attendanceRecords   AttendanceRecord[]
  visitors            Visitor[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
  @@index([deletedAt])
  @@index([organizationId, status, deletedAt])
  @@map("branches")
}

// ---------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------
model InventoryCategory {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items        InventoryItem[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("inventory_categories")
}

model Store {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  location       String?
  description    String?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  branch       Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items        InventoryItem[]
  movements    StockMovement[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("stores")
}

model InventoryItem {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String
  storeId        String?
  categoryId     String?
  sku            String
  name           String
  description    String?
  unitOfMeasure  String  @default("pcs")

  unitPrice    Decimal @db.Decimal(15, 2)
  costPrice    Decimal @default(0) @db.Decimal(15, 2)
  quantity     Int     @default(0)
  reorderLevel Int     @default(10)

  barcode     String?
  imageUrl    String?
  isActive    Boolean @default(true)
  isPublished Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization       @relation(fields: [organizationId], references: [id])
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  store        Store?             @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category     InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements    StockMovement[]
  saleItems    SaleItem[]

  @@unique([branchId, sku])
  @@index([organizationId])
  @@index([branchId])
  @@index([categoryId])
  @@index([storeId])
  @@index([deletedAt])
  @@index([branchId, deletedAt, quantity])
  @@index([branchId, isActive, deletedAt])
  @@map("inventory_items")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String
  itemId         String
  storeId        String?
  type           StockMovementType
  quantityDelta  Int
  balanceAfter   Int
  unitCost       Decimal?          @db.Decimal(15, 2)
  reason         String?
  referenceType  String?
  referenceId    String?
  performedById  String?
  createdAt      DateTime          @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item         InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  store        Store?        @relation(fields: [storeId], references: [id], onDelete: SetNull)
  performedBy  User?         @relation("StockMovementPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([itemId])
  @@index([storeId])
  @@index([performedById])
  @@index([branchId, createdAt])
  @@index([itemId, createdAt])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------
// Customers and Sales / POS
// ---------------------------------------------------------------------
model Customer {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String
  clientId       String?
  customerNumber String
  name           String
  phone          String?
  email          String?
  company        String?
  address        String?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  client       Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull)
  sales        Sale[]
  debtAccount  CustomerDebtAccount?

  @@unique([branchId, customerNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([branchId, deletedAt, createdAt])
  @@map("erp_customers")
}

model Sale {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  customerId     String?
  cashierId      String?
  receiptNumber  String
  status         SaleStatus  @default(COMPLETED)
  channel        SaleChannel @default(POS)
  currency       Currency    @default(KES)

  subtotal       Decimal @db.Decimal(15, 2)
  discountAmount Decimal @default(0) @db.Decimal(15, 2)
  taxRate        Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(15, 2)
  totalAmount    Decimal @db.Decimal(15, 2)
  amountPaid     Decimal @default(0) @db.Decimal(15, 2)
  amountDue      Decimal @default(0) @db.Decimal(15, 2)

  notes    String?
  soldAt   DateTime  @default(now())
  voidedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier      User?         @relation("SaleCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  lineItems    SaleItem[]
  payments     SalePayment[]
  debtPayments DebtPayment[]

  @@unique([branchId, receiptNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
  @@index([cashierId])
  @@index([deletedAt])
  @@index([branchId, soldAt])
  @@index([branchId, status, deletedAt, soldAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  itemId    String?
  name      String
  sku       String?
  quantity  Int
  unitPrice Decimal @db.Decimal(15, 2)
  discount  Decimal @default(0) @db.Decimal(15, 2)
  lineTotal Decimal @db.Decimal(15, 2)

  createdAt DateTime @default(now())

  sale Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  item InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([itemId])
  @@map("sale_items")
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String
  method    PaymentMethod @default(CASH)
  amount    Decimal       @db.Decimal(15, 2)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([paidAt])
  @@map("sale_payments")
}

// ---------------------------------------------------------------------
// Debt Management
// ---------------------------------------------------------------------
model CustomerDebtAccount {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String
  customerId     String            @unique
  status         DebtAccountStatus @default(CURRENT)
  creditLimit    Decimal           @default(0) @db.Decimal(15, 2)
  outstanding    Decimal           @default(0) @db.Decimal(15, 2)
  totalBilled    Decimal           @default(0) @db.Decimal(15, 2)
  totalPaid      Decimal           @default(0) @db.Decimal(15, 2)
  dueDate        DateTime?
  lastPaymentAt  DateTime?
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id])
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments     DebtPayment[]

  @@index([organizationId])
  @@index([branchId])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, dueDate])
  @@map("customer_debt_accounts")
}

model DebtPayment {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  debtAccountId  String
  saleId         String?
  amount         Decimal       @db.Decimal(15, 2)
  method         PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  receivedById   String?
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organization Organization        @relation(fields: [organizationId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  debtAccount  CustomerDebtAccount @relation(fields: [debtAccountId], references: [id], onDelete: Cascade)
  sale         Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  receivedBy   User?               @relation("DebtPaymentReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([debtAccountId])
  @@index([saleId])
  @@index([receivedById])
  @@index([branchId, paidAt])
  @@map("debt_payments")
}

// ---------------------------------------------------------------------
// Expenses and Accounts
// ---------------------------------------------------------------------
model ExpenseCategory {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("expense_categories")
}

model Expense {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  categoryId     String?
  accountId      String?
  reference      String
  description    String
  amount         Decimal       @db.Decimal(15, 2)
  currency       Currency      @default(KES)
  method         PaymentMethod @default(CASH)
  receiptUrl     String?
  incurredAt     DateTime      @default(now())
  recordedById   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category     ExpenseCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account      FinancialAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  recordedBy   User?             @relation("ExpenseRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([branchId, reference])
  @@index([organizationId])
  @@index([branchId])
  @@index([categoryId])
  @@index([accountId])
  @@index([recordedById])
  @@index([deletedAt])
  @@index([branchId, incurredAt])
  @@map("expenses")
}

model FinancialAccount {
  id             String               @id @default(uuid())
  organizationId String
  branchId       String
  name           String
  type           FinancialAccountType @default(CASH)
  accountNumber  String?
  provider       String?
  currency       Currency             @default(KES)
  openingBalance Decimal              @default(0) @db.Decimal(15, 2)
  currentBalance Decimal              @default(0) @db.Decimal(15, 2)
  isActive       Boolean              @default(true)
  description    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  transactions AccountTransaction[]
  expenses     Expense[]

  @@unique([branchId, name])
  @@index([organizationId])
  @@index([branchId])
  @@index([type])
  @@index([deletedAt])
  @@map("financial_accounts")
}

model AccountTransaction {
  id             String                 @id @default(uuid())
  organizationId String
  branchId       String
  accountId      String
  type           AccountTransactionType
  amount         Decimal                @db.Decimal(15, 2)
  balanceAfter   Decimal                @db.Decimal(15, 2)
  description    String
  reference      String?
  referenceType  String?
  referenceId    String?
  isManualEntry  Boolean                @default(false)
  recordedById   String?
  occurredAt     DateTime               @default(now())
  createdAt      DateTime               @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  account      FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation("AccountTransactionRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([accountId])
  @@index([recordedById])
  @@index([accountId, occurredAt])
  @@index([branchId, occurredAt])
  @@map("account_transactions")
}

// ---------------------------------------------------------------------
// Operations Control - Vat Leach
// Gold-processing vat leach tanks rented out to miners at the plant.
// Tracks the unit, the rental assignment, deposits held and payments so
// the Payment Reminders and Payment History views can be driven.
// ---------------------------------------------------------------------
model VatLeachUnit {
  id             String         @id @default(uuid())
  organizationId String
  branchId       String
  miningSiteId   String?
  code           String
  name           String?
  location       String?
  capacityTonnes Decimal?       @db.Decimal(10, 2)
  status         VatLeachStatus @default(AVAILABLE)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  miningSite   MiningSite?      @relation(fields: [miningSiteId], references: [id], onDelete: SetNull)
  rentals      VatLeachRental[]

  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([miningSiteId])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt])
  @@map("vat_leach_units")
}

model VatLeachRental {
  id             String               @id @default(uuid())
  organizationId String
  branchId       String
  vatLeachUnitId String
  reference      String
  status         VatLeachRentalStatus @default(ACTIVE)

  renterName     String
  renterPhone    String?
  renterEmail    String?
  renterIdNumber String?
  renterLocation String?

  rentalRate  Decimal  @db.Decimal(15, 2)
  depositHeld Decimal  @default(0) @db.Decimal(15, 2)
  totalBilled Decimal  @default(0) @db.Decimal(15, 2)
  totalPaid   Decimal  @default(0) @db.Decimal(15, 2)
  outstanding Decimal  @default(0) @db.Decimal(15, 2)
  currency    Currency @default(KES)

  startDate       DateTime
  endDate         DateTime?
  nextPaymentDue  DateTime?
  lastPaymentAt   DateTime?
  depositRefunded Boolean   @default(false)
  notes           String?

  recordedById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization      @relation(fields: [organizationId], references: [id])
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  vatLeachUnit VatLeachUnit      @relation(fields: [vatLeachUnitId], references: [id], onDelete: Cascade)
  recordedBy   User?             @relation("VatLeachRentalRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  payments     VatLeachPayment[]

  @@unique([branchId, reference])
  @@index([organizationId])
  @@index([branchId])
  @@index([vatLeachUnitId])
  @@index([recordedById])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt, nextPaymentDue])
  @@map("vat_leach_rentals")
}

model VatLeachPayment {
  id               String        @id @default(uuid())
  organizationId   String
  branchId         String
  vatLeachRentalId String
  amount           Decimal       @db.Decimal(15, 2)
  method           PaymentMethod @default(CASH)
  reference        String?
  isDeposit        Boolean       @default(false)
  notes            String?
  paidAt           DateTime      @default(now())
  createdAt        DateTime      @default(now())

  rental VatLeachRental @relation(fields: [vatLeachRentalId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([branchId])
  @@index([vatLeachRentalId])
  @@index([branchId, paidAt])
  @@map("vat_leach_payments")
}

// ---------------------------------------------------------------------
// Operations Control - Stock Pile
// ---------------------------------------------------------------------
model StockPile {
  id             String          @id @default(uuid())
  organizationId String
  branchId       String
  miningSiteId   String?
  code           String
  name           String
  oreType        String?
  mineralType    MineralType?
  location       String?
  status         StockPileStatus @default(ACCUMULATING)

  tonnage        Decimal  @default(0) @db.Decimal(15, 4)
  estimatedGrade Decimal? @db.Decimal(8, 3)
  estimatedValue Decimal? @db.Decimal(15, 2)
  currency       Currency @default(KES)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id])
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  miningSite   MiningSite?         @relation(fields: [miningSiteId], references: [id], onDelete: SetNull)
  movements    StockPileMovement[]

  @@unique([branchId, code])
  @@index([organizationId])
  @@index([branchId])
  @@index([miningSiteId])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt])
  @@map("stock_piles")
}

model StockPileMovement {
  id             String                @id @default(uuid())
  organizationId String
  branchId       String
  stockPileId    String
  type           StockPileMovementType
  tonnageDelta   Decimal               @db.Decimal(15, 4)
  balanceAfter   Decimal               @db.Decimal(15, 4)
  grade          Decimal?              @db.Decimal(8, 3)
  reason         String?
  recordedById   String?
  occurredAt     DateTime              @default(now())
  createdAt      DateTime              @default(now())

  stockPile  StockPile @relation(fields: [stockPileId], references: [id], onDelete: Cascade)
  recordedBy User?     @relation("StockPileMovementRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([stockPileId])
  @@index([recordedById])
  @@index([stockPileId, occurredAt])
  @@map("stock_pile_movements")
}

// ---------------------------------------------------------------------
// Operations Control - Security
// ---------------------------------------------------------------------
model SecurityLog {
  id             String            @id @default(uuid())
  organizationId String
  branchId       String
  miningSiteId   String?
  reference      String
  type           SecurityLogType   @default(INCIDENT)
  severity       SecuritySeverity  @default(LOW)
  status         SecurityLogStatus @default(OPEN)

  title       String
  description String?
  location    String?
  guardName   String?
  shift       String?

  reportedById String?
  occurredAt   DateTime  @default(now())
  resolvedAt   DateTime?
  resolution   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  miningSite   MiningSite?  @relation(fields: [miningSiteId], references: [id], onDelete: SetNull)
  reportedBy   User?        @relation("SecurityLogReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)

  @@unique([branchId, reference])
  @@index([organizationId])
  @@index([branchId])
  @@index([miningSiteId])
  @@index([reportedById])
  @@index([status])
  @@index([severity])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt, occurredAt])
  @@map("security_logs")
}

// ---------------------------------------------------------------------
// HR - Staff, Payroll, Leave, Attendance
// Staff are not necessarily system users, so userId is optional.
// ---------------------------------------------------------------------
model Staff {
  id             String  @id @default(uuid())
  organizationId String
  branchId       String
  userId         String? @unique
  staffNumber    String

  firstName String
  lastName  String
  idNumber  String?
  phone     String?
  email     String?
  address   String?

  position       String?
  department     String?
  employmentType EmploymentType    @default(PERMANENT)
  paymentTerms   StaffPaymentTerms @default(MONTHLY)
  status         StaffStatus       @default(ACTIVE)

  baseSalary Decimal? @db.Decimal(15, 2)
  currency   Currency @default(KES)

  hireDate      DateTime?
  terminationAt DateTime?
  photoUrl      String?
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization   Organization       @relation(fields: [organizationId], references: [id])
  branch         Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  payrollEntries PayrollEntry[]
  leaveRequests  LeaveRequest[]
  attendance     AttendanceRecord[]

  @@unique([branchId, staffNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt])
  @@map("staff")
}

model PayrollRun {
  id             String           @id @default(uuid())
  organizationId String
  branchId       String
  reference      String
  periodMonth    Int
  periodYear     Int
  status         PayrollRunStatus @default(DRAFT)

  totalGross      Decimal  @default(0) @db.Decimal(15, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(15, 2)
  totalNet        Decimal  @default(0) @db.Decimal(15, 2)
  staffCount      Int      @default(0)
  currency        Currency @default(KES)

  processedById String?
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  notes         String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id])
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  processedBy  User?          @relation("PayrollProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)
  approvedBy   User?          @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  entries      PayrollEntry[]

  @@unique([branchId, periodYear, periodMonth])
  @@unique([branchId, reference])
  @@index([organizationId])
  @@index([branchId])
  @@index([processedById])
  @@index([approvedById])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, periodYear, periodMonth, status])
  @@map("payroll_runs")
}

model PayrollEntry {
  id           String             @id @default(uuid())
  payrollRunId String
  staffId      String
  status       PayrollEntryStatus @default(PENDING)

  grossPay      Decimal  @db.Decimal(15, 2)
  allowances    Decimal  @default(0) @db.Decimal(15, 2)
  deductions    Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2)
  netPay        Decimal  @db.Decimal(15, 2)
  daysWorked    Int?
  overtimeHours Decimal? @db.Decimal(8, 2)

  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  paidAt        DateTime?
  reference     String?
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staff      Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, staffId])
  @@index([payrollRunId])
  @@index([staffId])
  @@index([status])
  @@map("payroll_entries")
}

model LeaveRequest {
  id             String      @id @default(uuid())
  organizationId String
  branchId       String
  staffId        String
  type           LeaveType   @default(ANNUAL)
  status         LeaveStatus @default(PENDING)

  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNotes  String?
  returnedAt   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("LeaveReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@index([staffId])
  @@index([reviewedById])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt, endDate])
  @@map("leave_requests")
}

model AttendanceRecord {
  id             String           @id @default(uuid())
  organizationId String
  branchId       String
  staffId        String
  status         AttendanceStatus @default(CHECKED_IN)
  workDate       DateTime
  checkInAt      DateTime?
  checkOutAt     DateTime?
  hoursWorked    Decimal?         @db.Decimal(8, 2)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  staff        Staff        @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, workDate])
  @@index([organizationId])
  @@index([branchId])
  @@index([staffId])
  @@index([branchId, workDate])
  @@map("attendance_records")
}

// ---------------------------------------------------------------------
// Visitors Management
// ---------------------------------------------------------------------
model Visitor {
  id             String        @id @default(uuid())
  organizationId String
  branchId       String
  badgeNumber    String
  status         VisitorStatus @default(CHECKED_IN)

  fullName     String
  idNumber     String?
  phone        String?
  email        String?
  company      String?
  purpose      String?
  hostName     String?
  vehiclePlate String?

  checkInAt  DateTime  @default(now())
  checkOutAt DateTime?
  notes      String?

  registeredById String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  registeredBy User?        @relation("VisitorRegisteredBy", fields: [registeredById], references: [id], onDelete: SetNull)

  @@unique([branchId, badgeNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([registeredById])
  @@index([status])
  @@index([deletedAt])
  @@index([branchId, status, deletedAt, checkInAt])
  @@map("visitors")
}
