# =============================================================================
# GREEN NGORIA SUPPLIES LIMITED — ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in all values before running the application.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Public-facing URLs (production: https://greenngoria.com etc.)
FRONTEND_URL=http://localhost:4000
CLIENT_PORTAL_URL=http://localhost:4001
ADMIN_URL=http://localhost:4002

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:4001,http://localhost:4002

# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL / Supabase
# -----------------------------------------------------------------------------
# Primary connection (pooled via PgBouncer for serverless/edge)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/greenngoria?schema=public

# Direct connection (used for Prisma migrations — bypasses pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/greenngoria?schema=public

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-minimum-64-chars
JWT_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string-minimum-64-chars
JWT_REFRESH_EXPIRES_IN=7d

SESSION_SECRET=change-me-to-another-long-random-secret-minimum-64-chars

# MFA — TOTP issuer name shown in authenticator apps
MFA_ISSUER=GreenNgoria

# Account lockout
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# OBJECT STORAGE
# -----------------------------------------------------------------------------
# Provider: supabase | s3 | local
STORAGE_PROVIDER=local

STORAGE_BUCKET=greenngoria-documents

# S3-compatible (used when STORAGE_PROVIDER=s3)
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_BUCKET=

# Local storage path (used when STORAGE_PROVIDER=local, development only)
STORAGE_LOCAL_PATH=./storage

# Signed URL expiry in seconds
STORAGE_SIGNED_URL_EXPIRES=3600

# -----------------------------------------------------------------------------
# EMAIL
# -----------------------------------------------------------------------------
MAIL_PROVIDER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=noreply@greenngoria.com
MAIL_PASSWORD=your-smtp-password
MAIL_FROM="Green Ngoria Supplies Limited <noreply@greenngoria.com>"

# Resend (alternative provider — set MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Email queue retry settings
MAIL_QUEUE_ATTEMPTS=3
MAIL_QUEUE_BACKOFF_DELAY=5000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# Stricter limits for auth endpoints
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# -----------------------------------------------------------------------------
# FILE UPLOADS
# -----------------------------------------------------------------------------
# Maximum file size in bytes (default: 50 MB)
UPLOAD_MAX_FILE_SIZE=52428800

# Allowed MIME types (comma-separated)
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,application/zip

# -----------------------------------------------------------------------------
# PDF GENERATION
# -----------------------------------------------------------------------------
PDF_QUEUE_CONCURRENCY=2
PDF_CHROMIUM_PATH=

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
SENTRY_DSN=

LOG_LEVEL=debug

# Enable OpenTelemetry tracing (true | false)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=greenngoria-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# -----------------------------------------------------------------------------
# ENCRYPTION
# -----------------------------------------------------------------------------
# 32-byte hex key for encrypting sensitive fields at rest
ENCRYPTION_KEY=change-me-to-a-32-byte-hex-string-000000000000000000000000000000

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
FEATURE_MFA_ENABLED=true
FEATURE_EMAIL_VERIFICATION_REQUIRED=true
FEATURE_MAINTENANCE_MODE=false
